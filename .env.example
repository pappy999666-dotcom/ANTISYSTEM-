# Application
NODE_ENV=development
APP_DEBUG=false

# Logger
LOG_LEVEL=info

# Database (set driver to: sqlite | mongodb | postgres)
DB_DRIVER=sqlite
DB_SQLITE_PATH=storage/database.sqlite

# MongoDB (if DB_DRIVER=mongodb)
DB_MONGO_URI=
DB_MONGO_NAME=pappybot

# PostgreSQL (if DB_DRIVER=postgres)
DB_PG_HOST=localhost
DB_PG_PORT=5432
DB_PG_DATABASE=pappybot
DB_PG_USER=
DB_PG_PASSWORD=

# Cache (set driver to: memory | redis)
CACHE_DRIVER=memory
REDIS_URL=

# Commands
CMD_PREFIX=!

# Sessions
SESSIONS_PATH=storage/sessions

# Owner
GLOBAL_OWNER_NUMBER=

# Telegram Control Panel
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Web Dashboard
WEB_PORT=3000
WEB_ENABLED=true
WEB_SECRET=change-this-secret
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=change-this-jwt-secret
